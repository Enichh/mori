# CDN rewrites for dynamic routes — serve the shell HTML for all matching paths
# Targets match the actual filenames generated by Next.js (placeholder params)

# Sports API proxy (force rewrite, preserves query params)
/api/sports/*  https://api.cdnlivetv.ru/api/v1/:splat  200!

/movies/*        /movies/placeholder.html                        200
/tv/*            /tv/placeholder.html                            200
/anime/*         /anime/placeholder.html                         200
/sports/*        /sports/basketball.html                         200
/tv/*/season/*/episode/*  /tv/placeholder/season/1/episode/1.html  200
/watch/movie/*   /watch/movie/placeholder.html                   200
/watch/tv/*/*/*  /watch/tv/placeholder/1/1.html                  200
/watch/anime/*/* /watch/anime/placeholder/1.html                 200
/watch/sport/*   /watch/sport/placeholder.html                   200

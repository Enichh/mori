import type { SortOption, SortItem } from '@/types';

const defaultSortOptions: SortItem[] = [
  { value: 'popularity.desc', label: 'Popularity' },
  { value: 'vote_average.desc', label: 'Rating' },
  { value: 'release_date.desc', label: 'Release Date' },

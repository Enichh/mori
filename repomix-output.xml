                    {member.name}
                  </p>
                  <p className="text-[10px] text-muted-foreground line-clamp-1">
                    {member.character}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}

      {/* Similar */}
      {similarMovies.length > 0 && (
        <MediaGrid
          title="Similar Movies"
          items={similarMovies}
          mediaType="movie"
        />
      )}
    </div>
  );
}

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
    * {
        @apply border-border;
    }

    html {
        @apply bg-background text-foreground antialiased;
        font-family: "Inter Tight", system-ui, sans-serif;
        scroll-behavior: smooth;
    }

    body {
        @apply bg-background text-foreground min-h-screen;
        font-feature-settings: "ss01", "ss02", "cv01", "cv02";
    }

    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-family: "PT Serif", Georgia, serif;
        font-weight: 400;
    }

    ::selection {
        @apply bg-primary/30 text-foreground;
    }

    ::-webkit-scrollbar {
        width: 4px;
        height: 4px;
    }
    ::-webkit-scrollbar-track {
        @apply bg-background;
    }
    ::-webkit-scrollbar-thumb {
        @apply bg-muted-foreground/20 hover:bg-muted-foreground/40;
    }
}

@layer components {
    .container-cine {
        @apply max-w-[1496px] mx-auto px-4 sm:px-6 lg:px-8;
    }

    /* ---- zkPass-style scanline overlay ---- */
    .scanlines {
        position: relative;
    }
    .scanlines::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 5;
        background: repeating-linear-gradient(
            0deg,
            rgba(255, 255, 255, 0.018) 0px,
            rgba(255, 255, 255, 0.018) 1px,
            transparent 1px,
            transparent 3px
        );
    }

    /* ---- zkPass-style dot grid ---- */
    .dot-grid {
        background-image: radial-gradient(
            circle,
            rgba(255, 255, 255, 0.06) 1px,
            transparent 1px
        );
        background-size: 44px 44px;
    }

    /* ---- zkPass-style gradient overlays ---- */
    .gradient-radial-hero {
        background: radial-gradient(
            ellipse 70% 50% at 50% 50%,
            rgba(40, 48, 30, 0.18),
            rgba(0, 0, 0, 0) 72%
        );
    }

    .gradient-overlay {
        background: linear-gradient(to top, #000000 0%, transparent 50%);
    }

    .gradient-overlay-bottom {
        background: linear-gradient(to bottom, #000000 0%, transparent 50%);
    }

    .gradient-overlay-full {
        background: linear-gradient(
            to top,
            #000000 10%,
            transparent 40%,
            transparent 60%,
            #000000 90%
        );
    }

    /* ---- zkPass-style text glow ---- */
    .text-glow {
        text-shadow:
            0 0 3px rgba(197, 255, 74, 0.35),
            0 0 7px rgba(255, 255, 255, 0.4);
    }

    .text-glow-strong {
        text-shadow:
            0 0 20px rgba(197, 255, 74, 0.5),
            0 0 40px rgba(197, 255, 74, 0.3);
    }

    /* ---- zkPass-style terminal box ---- */
    .terminal-box {
        @apply border border-border bg-card font-mono text-xs text-muted-foreground p-4;
        border-left: 2px solid #c5ff4a;
    }

    /* ---- zkPass-style ASCII art ---- */
    .ascii-art {
        @apply font-mono text-[8px] leading-[0.92] text-muted-foreground/30 select-none whitespace-pre pointer-events-none;
    }

    .ascii-art-layer {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(calc(-50% - 1.2vw), -50%);
        margin: 0;
        font-family: "JetBrains Mono", ui-monospace, monospace;
        font-size: calc(0.487805vw);
        line-height: 0.92;
        letter-spacing: 0;
        white-space: pre;
        text-align: left;
        user-select: none;
        pointer-events: none;
    }

    /* ---- zkPass-style crosshair corner markers ---- */
    .crosshair-corners {
        position: relative;
    }
    .crosshair-corners::before,
    .crosshair-corners::after {
        content: "";
        position: absolute;
        width: 14px;
        height: 14px;
        z-index: 3;
        pointer-events: none;
    }

    /* ---- zkPass-style glowing dot ---- */
    .glow-dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        position: absolute;
        z-index: 2;
    }

    .glow-dot-lime {
        background: #c5ff4a;
        box-shadow:
            0 0 10px 2px rgba(197, 255, 74, 0.65),
            0 0 22px 6px rgba(197, 255, 74, 0.2);
    }

    .glow-dot-white {
        background: #ffffff;
        box-shadow:
            0 0 10px 2px rgba(255, 255, 255, 0.6),
            0 0 22px 6px rgba(255, 255, 255, 0.18);
    }

    /* ---- zkPass-style marquee ticker ---- */
    .marquee-ticker {
        overflow: hidden;
        white-space: nowrap;
        border-top: 1.5px solid rgba(61, 61, 61, 0.5);
        border-bottom: 1.5px solid rgba(61, 61, 61, 0.5);
        padding: 14px 0;
        background: #000;
    }

    .marquee-ticker-content {
        display: inline-flex;
        animation: marquee 34s linear infinite;
        gap: 28px;
    }

    /* ---- zkPass-style section label ---- */
    .section-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: "Inter Tight", system-ui, sans-serif;
        font-size: 11px;
        letter-spacing: 0.18em;
        color: rgb(122, 122, 122);
        text-transform: uppercase;
    }

    /* ---- zkPass-style accent border card ---- */
    .card-accent {
        border: 1.5px solid rgba(61, 61, 61, 0.6);
        background: #000;
    }
}

@layer utilities {
    .text-balance {
        text-wrap: balance;
    }
    .border-1\.5 {
        border-width: 1.5px;
    }
    .scrollbar-none {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .scrollbar-none::-webkit-scrollbar {
        display: none;
    }
    .safe-area-bottom {
        padding-bottom: env(safe-area-inset-bottom, 0px);
    }
}
</file>


            <Link href={`/watch/sport/${event.id}`}>
              <Button
                variant="primary"
                size="lg"
                className="gap-2 font-semibold tracking-wider text-xs uppercase"
              >
                <Play className="h-4 w-4" fill="currentColor" />
                Watch Now
              </Button>
            </Link>
          </div>
        </div>
      </div>
    </section>
  );
}
